# FastAPI model locations. Relative paths resolve from the repository root;
# absolute paths are supported for mounted disks.
PIX2PIX_CHECKPOINT=pix2pix_gen_180.pth
SARFUSIONFORMER_CHECKPOINT=models/checkpoints/sarfusionformer_256_decoder_best.pt
COLOR_CORRECTOR_CHECKPOINT=models/checkpoints/color_corrector_256_best.pt

# Optional evidence-first single-image SAR translation. Disabled by default so
# existing SAR responses remain unchanged unless a deployment opts in explicitly.
SATQUERY_SAR_TRANSLATION_ENABLED=false
SATQUERY_SAR_TRANSLATION_MODEL=sarfusionformer
# Omit this variable to enable correction only when its checkpoint is configured.
# SATQUERY_SAR_TRANSLATION_USE_COLOR_CORRECTION=true
SATQUERY_SAR_TRANSLATION_OPTICAL_SPECIALISTS_ENABLED=true
SATQUERY_SAR_TRANSLATION_SAVE_ARTIFACTS=true
SATQUERY_SAR_TRANSLATION_DEVICE=auto

# Grounding Specialist v1.1 score policy. The production-safe default keeps
# Grounding DINO authoritative and only permits non-suppressing specialist
# score uplifts. `blend` is an evaluation mode; `specialist_only` is a
# compatibility/benchmark mode and is not recommended for production.
SATQUERY_GROUNDING_SPECIALIST_SCORE_MODE=fallback
SATQUERY_GROUNDING_DINO_WEIGHT=0.70
SATQUERY_GROUNDER_LOAD_ON_STARTUP=true
SATQUERY_GROUNDER_LOCAL_FILES_ONLY=true
# Optional explicit snapshot directory. It must contain config, processor,
# tokenizer, and model.safetensors files. Runtime downloads stay disabled unless
# SATQUERY_GROUNDER_ALLOW_DOWNLOAD=true is explicitly set outside a demo.
SATQUERY_GROUNDER_LOCAL_MODEL=
SATQUERY_GROUNDER_ALLOW_DOWNLOAD=false
SATQUERY_GROUNDING_SPECIALIST_WEIGHT=0.30

# Trusted browser origins. Add the deployed Vercel URL in Render; do not use *.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8520,http://localhost:8520

# Hugging Face checkpoint source. HF_TOKEN is required only for private/gated repos.
HF_MODEL_REPO=your-hf-username/geovision-checkpoints
HF_TOKEN=replace_with_a_read_token_for_private_repositories
PIX2PIX_REMOTE_FILENAME=pix2pix_gen_180.pth
SARFUSIONFORMER_REMOTE_FILENAME=sarfusionformer_256_decoder_best.pt
COLOR_CORRECTOR_REMOTE_FILENAME=color_corrector_256_best.pt

# Frontend build setting: use the public Render API URL when deploying to Vercel.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010

# Default local learned change engine. Relative checkpoint paths resolve from
# the repository root. Loading is lazy and process-wide; every failure falls
# back to the existing deterministic analyzer.
SATQUERY_CHANGE_ENGINE=changerex
SATQUERY_CHANGEREX_ENABLED=true
SATQUERY_CHANGEREX_CHECKPOINT=models/changerex/ChangerEx_r18-512x512_40k_levircd_20221223_120511.pth
SATQUERY_CHANGEREX_DEVICE=auto
SATQUERY_CHANGEREX_THRESHOLD=0.5
SATQUERY_CHANGEREX_MAXIMUM_DIMENSION=1024

# Optional alternate TTP learned engine. Select it with
# SATQUERY_CHANGE_ENGINE=ttp; its existing CUDA service remains unchanged.
TTP_ENABLED=true
TTP_DEFAULT_MODE=hybrid
TTP_SERVICE_URL=http://127.0.0.1:8000
TTP_CONNECT_TIMEOUT_SECONDS=2
TTP_READ_TIMEOUT_SECONDS=45
TTP_HEALTH_CACHE_SECONDS=10
# Set on the CUDA service. First-use lazy loading is the production default;
# startup loading remains available for an explicitly managed warm-up.
TTP_LOAD_ON_STARTUP=false
TTP_WARMUP_ON_STARTUP=true

# Optional SatQuery Vision Encoder v1 scene-level evidence. The adapter is verified
# before the exact OpenCLIP backbone is loaded. Relative paths resolve from this repo.
SVE_ENABLED=true
SVE_DEVICE=auto
SVE_MODEL_DIR=models/satquery_vision_encoder_v1
SVE_LOAD_ON_STARTUP=false
SVE_MAX_BATCH_SIZE=8
SVE_CACHE_SIZE=128
SVE_TIMEOUT_SECONDS=30

# Optional Google Gemini AI analysis. Keep all values server-side; never use NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
GEMINI_SUPPORTED_MODELS=gemini-3.5-flash,gemini-3.6-flash
# Deployment-owned key only; local users configure their own key in Settings → AI Providers.
GEMINI_API_KEY=replace_with_a_server_side_key
GEMINI_MODEL=gemini-3.5-flash
# Reserved for encrypted server-side secret-store deployments; do not commit it.
GEOVISION_SECRET_ENCRYPTION_KEY=replace_with_a_high_entropy_secret
